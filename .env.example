# Admin workspace access. Use independent, randomly generated values.
EMAILGO_ADMIN_PASSWORD=replace-with-a-long-unique-password
EMAILGO_SESSION_SECRET=replace-with-a-different-random-secret

# Set DATABASE_URL in production to the dedicated PostgreSQL database.
# Local development defaults to SQLite when DATABASE_URL is unset.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# SMTP relay used only for outbound transport. Email, thanks never sends through Resend.
EMAILGO_SMTP_HOST=mail.spacemail.com
EMAILGO_SMTP_PORT=465
EMAILGO_SMTP_USER=your-smtp-username
EMAILGO_SMTP_PASSWORD=your-smtp-password
# Port 465 uses implicit TLS.
EMAILGO_SMTP_SECURE=true

# Amazon SES example: EMAILGO_SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com, port 587, EMAILGO_SMTP_SECURE=false.

# Delivery events (bounces, spam complaints, deliveries) from Amazon SES via SNS.
# Subscribe https://<emailgo-host>/api/webhooks/ses?token=<EMAILGO_WEBHOOK_TOKEN> to the SNS topic.
EMAILGO_WEBHOOK_TOKEN=replace-with-a-long-random-token
EMAILGO_SNS_TOPIC_ARNS=arn:aws:sns:ap-southeast-2:123456789012:emailgo-events
