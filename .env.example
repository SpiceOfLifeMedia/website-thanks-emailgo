# Admin workspace access. Use independent, randomly generated values.
EMAILGO_ADMIN_PASSWORD=replace-with-a-long-unique-password
EMAILGO_SESSION_SECRET=replace-with-a-different-random-secret

# Set DATABASE_URL in production to the dedicated PostgreSQL database.
# Local development defaults to SQLite when DATABASE_URL is unset.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# SMTP relay used for outbound transport.
EMAILGO_SMTP_HOST=smtp.example.com
EMAILGO_SMTP_PORT=465
EMAILGO_SMTP_USER=your-smtp-username
EMAILGO_SMTP_PASSWORD=your-smtp-password
# Port 465 uses implicit TLS.
EMAILGO_SMTP_SECURE=true

# Vercel Cron uses this bearer secret to call the scheduled message worker.
CRON_SECRET=replace-with-an-independent-random-secret

# Optional domain-level open/click tracking. Keep both off until configured.
EMAILGO_PUBLIC_URL=https://emailgo.example.com
EMAILGO_TRACKING_SECRET=replace-with-an-independent-random-secret
EMAILGO_WEBHOOK_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
EMAILGO_PREFERENCES_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters

# Optional authentication for signed delivery-event notifications.
EMAILGO_WEBHOOK_TOKEN=replace-with-a-long-random-token
# Optional comma-separated allowlist of delivery notification source identifiers.
EMAILGO_SNS_TOPIC_ARNS=

# Optional inbound provider bridge. Configure an inbound mail service to send
# signed email.received JSON events to /api/internal/receiving. This does not
# create MX routing or receive mail by itself.
EMAILGO_INBOUND_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
EMAILGO_RECEIVING_API_KEY_ID=an-active-full-access-emailgo-key-id
