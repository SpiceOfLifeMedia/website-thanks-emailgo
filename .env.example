# Admin workspace access. Use independent, randomly generated values.
EMAILGO_ADMIN_PASSWORD=replace-with-a-long-unique-password
EMAILGO_SESSION_SECRET=replace-with-a-different-random-secret

# SMTP relay used only for outbound transport. Emailgo never sends through Resend.
EMAILGO_SMTP_HOST=smtp.example.com
EMAILGO_SMTP_PORT=587
EMAILGO_SMTP_USER=your-smtp-username
EMAILGO_SMTP_PASSWORD=your-smtp-password
EMAILGO_SMTP_SECURE=false
