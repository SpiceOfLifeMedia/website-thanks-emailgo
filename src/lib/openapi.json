    "/api/v1/events/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getEventSchema", "summary": "Retrieve an event definition by ID or name", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } }, "patch": { "operationId": "updateEventSchema", "summary": "Update or clear an event payload schema", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }, "delete": { "operationId": "deleteEventSchema", "summary": "Delete an event definition", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/events/send": { "post": { "operationId": "sendAutomationEvent", "summary": "Send an event to trigger matching automations", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/events/observed": { "get": { "operationId": "listObservedEvents", "summary": "List received event names and counts", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/webhooks": { "get": { "operationId": "listWebhooks", "summary": "List webhook endpoints", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "operationId": "createWebhook", "summary": "Create a webhook endpoint", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/webhooks/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getWebhook", "summary": "Retrieve a webhook endpoint", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "patch": { "operationId": "updateWebhook", "summary": "Update a webhook endpoint", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "delete": { "operationId": "deleteWebhook", "summary": "Disable a webhook endpoint", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/webhooks/{id}/deliveries": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "listWebhookDeliveries", "summary": "List webhook deliveries and attempts", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/webhooks/{id}/events": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "listWebhookEvents", "summary": "List events delivered to a webhook", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/After" }], "responses": { "200": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/webhooks/{id}/events/{eventId}": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string" } }], "get": { "operationId": "getWebhookEvent", "summary": "Retrieve a webhook event and its payload", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/webhooks/{id}/events/{eventId}/attempts": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string" } }], "get": { "operationId": "listWebhookEventAttempts", "summary": "List attempts for a webhook event", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/After" }], "responses": { "200": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/webhooks/{id}/events/{eventId}/replay": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string" } }], "post": { "operationId": "replayWebhookEvent", "summary": "Queue another delivery without changing existing retries", "responses": { "202": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/webhooks/{id}/replay": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "replayWebhookDelivery", "summary": "Replay a webhook event", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/webhooks/{id}/rotate-secret": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "rotateWebhookSecret", "summary": "Rotate a webhook signing secret", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/suppressions": { "get": { "operationId": "listSuppressions", "summary": "List workspace suppressions", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/After" }], "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "operationId": "addSuppression", "summary": "Suppress an email address", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/suppressions/{suppression}": { "parameters": [{ "name": "suppression", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Suppression ID or email address" }], "get": { "operationId": "getSuppression", "summary": "Retrieve a suppression by ID or email", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } }, "delete": { "operationId": "removeSuppression", "summary": "Remove a suppression by ID or email", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/suppressions/batch": { "post": { "operationId": "addSuppressionsBatch", "summary": "Add up to 100 suppressions", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" } } }, "delete": { "operationId": "removeSuppressionsBatch", "summary": "Remove up to 100 suppressions", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/usage": { "get": { "operationId": "getUsage", "summary": "Read current usage and self-hosted limits", "responses": { "200": { "description": "Current Emailgo usage and quota limits.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Usage" } } } } } } },
    "/api/v1/logs": { "get": { "operationId": "listApiLogs", "summary": "List authenticated API request logs", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/After" }, { "$ref": "#/components/parameters/Before" }], "responses": { "200": { "description": "Paginated API request logs.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiLogList" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/logs/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getApiLog", "summary": "Retrieve a request log with sanitized JSON bodies", "responses": { "200": { "description": "API request log detail.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiLog" } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/templates": { "get": { "operationId": "listTemplates", "summary": "List template metadata with draft and publication status; retrieve content by ID or alias", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/After" }, { "$ref": "#/components/parameters/Before" }], "responses": { "200": { "$ref": "#/components/responses/Json" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } }, "post": { "operationId": "createTemplate", "summary": "Create a draft template", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TemplateInput" } } } }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/templates/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getTemplate", "summary": "Retrieve a template by ID or alias", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } }, "patch": { "operationId": "updateTemplate", "summary": "Save a new draft version", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }, "delete": { "operationId": "deleteTemplate", "summary": "Delete a template and its stored versions", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/templates/{id}/publish": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "publishTemplate", "summary": "Publish the current draft version", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/templates/{id}/duplicate": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "duplicateTemplate", "summary": "Create a draft copy of a template", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string", "maxLength": 120 } }, "additionalProperties": false } } } }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/templates/{id}/versions": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "listTemplateVersions", "summary": "List immutable template draft and published versions", "responses": { "200": { "$ref": "#/components/responses/Json" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "securitySchemes": { "BearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "Emailgo API key" } },
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
      "EmailId": { "name": "email_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
      "After": { "name": "after", "in": "query", "schema": { "type": "string" } },
      "Before": { "name": "before", "in": "query", "schema": { "type": "string" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "schema": { "type": "string", "maxLength": 200 } }
    },
    "requestBodies": { "JsonObject": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } } },
    "schemas": {
      "Error": { "type": "object", "properties": { "error": { "oneOf": [{ "type": "string" }, { "type": "object", "properties": { "message": { "type": "string" } }, "required": ["message"] }] } }, "required": ["error"] },
      "Usage": { "type": "object", "required": ["object", "emails", "contacts", "segments", "broadcasts", "domains", "automation_runs", "rate_limit"], "properties": { "object": { "const": "usage" }, "emails": { "type": "object", "required": ["daily", "monthly"], "properties": { "daily": { "$ref": "#/components/schemas/EmailUsageWindow" }, "monthly": { "$ref": "#/components/schemas/EmailUsageWindow" } } }, "contacts": { "$ref": "#/components/schemas/ResourceUsage" }, "segments": { "$ref": "#/components/schemas/ResourceUsage" }, "broadcasts": { "$ref": "#/components/schemas/ResourceUsage" }, "domains": { "$ref": "#/components/schemas/ResourceUsage" }, "automation_runs": { "type": "object", "required": ["used", "limit", "resets_at"], "properties": { "used": { "type": "integer" }, "limit": { "type": ["integer", "null"] }, "resets_at": { "type": "string", "format": "date-time" } } }, "rate_limit": { "type": "object", "required": ["limit", "duration", "applies_to"], "properties": { "limit": { "type": "integer" }, "duration": { "type": "string" }, "applies_to": { "type": "string" } } } } },
      "ResourceUsage": { "type": "object", "required": ["used", "limit"], "properties": { "used": { "type": "integer" }, "limit": { "type": ["integer", "null"] } } },
      "EmailUsageWindow": { "type": "object", "required": ["used", "limit", "sent", "received", "resets_at"], "properties": { "used": { "type": "integer" }, "limit": { "type": ["integer", "null"] }, "sent": { "type": "integer" }, "received": { "type": "integer" }, "resets_at": { "type": "string", "format": "date-time" } } },
      "ApiLog": { "type": "object", "required": ["id", "object", "created_at", "endpoint", "method", "response_status", "user_agent", "request_bytes", "response_bytes"], "properties": { "id": { "type": "string" }, "object": { "const": "log" }, "created_at": { "type": "string", "format": "date-time" }, "endpoint": { "type": "string" }, "method": { "type": "string" }, "response_status": { "type": "integer" }, "user_agent": { "type": ["string", "null"] }, "request_bytes": { "type": ["integer", "null"] }, "response_bytes": { "type": ["integer", "null"] }, "api_key": { "type": "object", "properties": { "name": { "type": ["string", "null"] }, "prefix": { "type": ["string", "null"] } } }, "request_body": { "type": ["object", "array", "null"] }, "response_body": { "type": ["object", "array", "null"] } } },
      "ApiLogList": { "type": "object", "required": ["object", "data", "has_more"], "properties": { "object": { "const": "list" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/ApiLog" } }, "has_more": { "type": "boolean" }, "next_after": { "type": "string" }, "next_before": { "type": "string" } } },
      "EmailInput": { "type": "object", "required": ["to"], "properties": { "from": { "type": "string" }, "to": { "oneOf": [{ "type": "string", "format": "email" }, { "type": "array", "items": { "type": "string", "format": "email" }, "maxItems": 50 }] }, "subject": { "type": "string", "maxLength": 998 }, "text": { "type": "string" }, "html": { "type": "string" }, "template": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "variables": { "type": "object", "additionalProperties": { "type": ["string", "number"] } } } }, "template_id": { "type": "string", "description": "Legacy Emailgo template reference. Prefer template.id for published versions." }, "variables": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }, "cc": { "type": "array", "items": { "type": "string", "format": "email" } }, "bcc": { "type": "array", "items": { "type": "string", "format": "email" } }, "reply_to": { "type": "string", "format": "email" }, "headers": { "type": "object", "additionalProperties": { "type": "string" } }, "tags": { "type": "array", "items": { "type": "object", "required": ["name", "value"], "properties": { "name": { "type": "string" }, "value": { "type": "string" } } } }, "scheduled_at": { "type": "string", "format": "date-time" } } },
      "TemplateInput": { "type": "object", "required": ["name", "html"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "alias": { "type": "string", "maxLength": 120 }, "from": { "type": ["string", "null"] }, "subject": { "type": "string", "maxLength": 998 }, "reply_to": { "type": ["string", "null"] }, "html": { "type": "string", "maxLength": 500000 }, "text": { "type": ["string", "null"], "maxLength": 500000 }, "variables": { "type": "array", "maxItems": 50, "items": { "$ref": "#/components/schemas/TemplateVariableInput" } } } },
      "TemplateVariableInput": { "type": "object", "required": ["key", "type"], "properties": { "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,49}$" }, "type": { "enum": ["string", "number"] }, "fallback_value": { "type": ["string", "number", "null"] } } },
      "Email": { "type": "object", "properties": { "id": { "type": "string" }, "object": { "const": "email" }, "status": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "array", "items": { "type": "string" } }, "subject": { "type": "string" }, "text": { "type": "string" }, "html": { "type": "string" }, "created_at": { "type": "string", "format": "date-time" } }, "required": ["id", "object", "status"] },
      "EmailList": { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Email" } }, "has_more": { "type": "boolean" }, "next_after": { "type": "string" }, "next_before": { "type": "string" } }, "required": ["data", "has_more"] }
    },
    "responses": {
      "Error": { "description": "Request rejected", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Json": { "description": "JSON response", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
      "Email": { "description": "Email resource", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Email" } } } },
      "EmailList": { "description": "Paginated email resources", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmailList" } } } }
    }
  }
}
