{
  "openapi": "3.1.0",
  "info": {
    "title": "Emailgo API",
    "version": "0.2.0",
    "description": "Emailgo email sending, domains, API keys, contacts, audiences, broadcasts, automations, inbound receiving, webhooks, suppressions and usage. Emailgo uses its configured SMTP relay and does not call Resend."
  },
  "servers": [{ "url": "https://emailgo.example.com" }],
  "security": [{ "BearerAuth": [] }],
  "paths": {
    "/api/v1/emails": {
      "get": { "operationId": "listEmails", "summary": "List sent and scheduled emails", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/After" }, { "$ref": "#/components/parameters/Before" }], "responses": { "200": { "$ref": "#/components/responses/EmailList" }, "401": { "$ref": "#/components/responses/Error" } } },
      "post": { "operationId": "sendEmail", "summary": "Send or schedule an email", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmailInput" } } } }, "responses": { "200": { "$ref": "#/components/responses/Email" }, "202": { "$ref": "#/components/responses/Email" }, "400": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/emails/batch": { "post": { "operationId": "sendEmailBatch", "summary": "Send up to 100 emails", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "207": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/emails/{email_id}": { "parameters": [{ "$ref": "#/components/parameters/EmailId" }], "get": { "operationId": "getEmail", "summary": "Retrieve an email", "responses": { "200": { "$ref": "#/components/responses/Email" }, "404": { "$ref": "#/components/responses/Error" } } }, "patch": { "operationId": "rescheduleEmail", "summary": "Change a scheduled email time", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/emails/{email_id}/cancel": { "parameters": [{ "$ref": "#/components/parameters/EmailId" }], "post": { "operationId": "cancelEmail", "summary": "Cancel a scheduled email", "responses": { "200": { "$ref": "#/components/responses/Json" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/emails/{email_id}/events": { "parameters": [{ "$ref": "#/components/parameters/EmailId" }], "get": { "operationId": "listEmailEvents", "summary": "List tracking events for an email", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/emails/receiving": { "get": { "operationId": "listReceivedEmails", "summary": "List received emails", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/After" }], "responses": { "200": { "$ref": "#/components/responses/Json" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/emails/receiving/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getReceivedEmail", "summary": "Retrieve an inbound email", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/emails/receiving/{id}/attachments": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "listReceivedEmailAttachments", "summary": "List inbound email attachments", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/emails/receiving/{id}/attachments/{attachment_id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "attachment_id", "in": "path", "required": true, "schema": { "type": "string" } }], "get": { "operationId": "downloadReceivedEmailAttachment", "summary": "Download an inbound attachment", "responses": { "200": { "description": "Raw attachment bytes", "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } } } } } },
    "/api/v1/api-keys": { "get": { "operationId": "listApiKeys", "summary": "List active API keys", "responses": { "200": { "$ref": "#/components/responses/Json" }, "403": { "$ref": "#/components/responses/Error" } } }, "post": { "operationId": "createApiKey", "summary": "Create a scoped API key", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/api-keys/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getApiKey", "summary": "Retrieve an API key", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "patch": { "operationId": "updateApiKey", "summary": "Rename an API key", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "delete": { "operationId": "revokeApiKey", "summary": "Revoke an API key", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/domains": { "get": { "operationId": "listDomains", "summary": "List sender domains", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "operationId": "createDomain", "summary": "Add a sender domain", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/domains/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getDomain", "summary": "Retrieve a sender domain", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "patch": { "operationId": "updateDomain", "summary": "Update tracking settings", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "delete": { "operationId": "deleteDomain", "summary": "Delete an unused sender domain", "responses": { "200": { "$ref": "#/components/responses/Json" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/domains/{id}/verify": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "verifyDomain", "summary": "Verify domain ownership through DNS", "responses": { "200": { "$ref": "#/components/responses/Json" }, "422": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/domains/{id}/dns": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "inspectDomainDns", "summary": "Inspect SPF, DMARC, MX and DKIM status", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/contacts": { "get": { "operationId": "listContacts", "summary": "List contacts", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "name": "after", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "operationId": "createContact", "summary": "Create a contact", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/contacts/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getContact", "summary": "Retrieve a contact", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "patch": { "operationId": "updateContact", "summary": "Update contact properties and consent state", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "delete": { "operationId": "deleteContact", "summary": "Delete a contact", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/contacts/{id}/topics": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "listContactTopics", "summary": "Read contact topic preferences", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "put": { "operationId": "updateContactTopics", "summary": "Replace contact topic preferences", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/contact-properties": { "get": { "operationId": "listContactProperties", "summary": "List contact property definitions", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "operationId": "createContactProperty", "summary": "Create a typed contact property with an optional broadcast fallback", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/contact-properties/{key}": { "parameters": [{ "name": "key", "in": "path", "required": true, "schema": { "type": "string" } }], "get": { "operationId": "getContactProperty", "summary": "Retrieve a contact property definition", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } }, "patch": { "operationId": "updateContactProperty", "summary": "Update a contact property definition", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" } } }, "delete": { "operationId": "deleteContactProperty", "summary": "Delete a definition while preserving contact values", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/segments": { "get": { "operationId": "listSegments", "summary": "List saved segments", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "operationId": "createSegment", "summary": "Create a saved segment", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/segments/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getSegment", "summary": "Retrieve a saved segment", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "patch": { "operationId": "updateSegment", "summary": "Update a saved segment", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "delete": { "operationId": "deleteSegment", "summary": "Delete a saved segment", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/segments/{id}/contacts": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "listSegmentContacts", "summary": "List current segment members", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/topics": { "get": { "operationId": "listTopics", "summary": "List preference topics", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "operationId": "createTopic", "summary": "Create a preference topic", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/topics/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getTopic", "summary": "Retrieve a preference topic", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "patch": { "operationId": "updateTopic", "summary": "Update a preference topic", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "delete": { "operationId": "archiveTopic", "summary": "Archive a preference topic", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/broadcasts": { "get": { "operationId": "listBroadcasts", "summary": "List campaigns", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "operationId": "createBroadcast", "summary": "Create a campaign draft", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/broadcasts/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getBroadcast", "summary": "Retrieve a campaign", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "patch": { "operationId": "updateBroadcast", "summary": "Update a draft campaign", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "delete": { "operationId": "deleteBroadcast", "summary": "Delete a draft campaign", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/broadcasts/{id}/send": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "sendBroadcast", "summary": "Queue or schedule a campaign", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "202": { "$ref": "#/components/responses/Json" }, "413": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/broadcasts/{id}/cancel": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "cancelBroadcast", "summary": "Cancel pending campaign messages", "responses": { "200": { "$ref": "#/components/responses/Json" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/automations": { "get": { "operationId": "listAutomations", "summary": "List automation workflows", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "operationId": "createAutomation", "summary": "Create an event driven workflow", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/automations/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getAutomation", "summary": "Retrieve a workflow", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "patch": { "operationId": "updateAutomation", "summary": "Update or pause a workflow", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "409": { "$ref": "#/components/responses/Error" } } }, "delete": { "operationId": "archiveAutomation", "summary": "Archive a workflow while retaining runs", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/automations/{id}/start": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "startAutomation", "summary": "Activate a workflow", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/automations/{id}/stop": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "stopAutomation", "summary": "Pause new workflow runs", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/automations/{id}/runs": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "listAutomationRuns", "summary": "List workflow runs", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/After" }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/automations/{id}/runs/{runId}": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "runId", "in": "path", "required": true, "schema": { "type": "string" } }], "get": { "operationId": "getAutomationRun", "summary": "Retrieve step level run history", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/automations/{id}/runs/{runId}/stop": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "runId", "in": "path", "required": true, "schema": { "type": "string" } }], "post": { "operationId": "stopAutomationRun", "summary": "Cancel an active workflow run", "responses": { "200": { "$ref": "#/components/responses/Json" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/events": { "get": { "operationId": "listAutomationEvents", "summary": "List observed event types", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "operationId": "sendAutomationEvent", "summary": "Send an event to trigger workflows or resume waits", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/webhooks": { "get": { "operationId": "listWebhooks", "summary": "List webhook endpoints", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "operationId": "createWebhook", "summary": "Create a webhook endpoint", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/webhooks/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getWebhook", "summary": "Retrieve a webhook endpoint", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "patch": { "operationId": "updateWebhook", "summary": "Update a webhook endpoint", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "delete": { "operationId": "deleteWebhook", "summary": "Disable a webhook endpoint", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/webhooks/{id}/deliveries": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "listWebhookDeliveries", "summary": "List webhook deliveries and attempts", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/webhooks/{id}/replay": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "replayWebhookDelivery", "summary": "Replay a webhook event", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/webhooks/{id}/rotate-secret": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "rotateWebhookSecret", "summary": "Rotate a webhook signing secret", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/api/v1/suppressions": { "get": { "operationId": "listSuppressions", "summary": "List workspace suppressions", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/After" }], "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "operationId": "addSuppression", "summary": "Suppress an email address", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/suppressions/{suppression}": { "parameters": [{ "name": "suppression", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Suppression ID or email address" }], "get": { "operationId": "getSuppression", "summary": "Retrieve a suppression by ID or email", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } }, "delete": { "operationId": "removeSuppression", "summary": "Remove a suppression by ID or email", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/suppressions/batch": { "post": { "operationId": "addSuppressionsBatch", "summary": "Add up to 100 suppressions", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" } } }, "delete": { "operationId": "removeSuppressionsBatch", "summary": "Remove up to 100 suppressions", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/usage": { "get": { "operationId": "getUsage", "summary": "Read current usage and self-hosted limits", "responses": { "200": { "description": "Current Emailgo usage and quota limits.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Usage" } } } } } } },
    "/api/v1/logs": { "get": { "operationId": "listApiLogs", "summary": "List authenticated API request logs", "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/After" }, { "$ref": "#/components/parameters/Before" }], "responses": { "200": { "description": "Paginated API request logs.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiLogList" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/logs/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getApiLog", "summary": "Retrieve a request log with sanitized JSON bodies", "responses": { "200": { "description": "API request log detail.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiLog" } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "securitySchemes": { "BearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "Emailgo API key" } },
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
      "EmailId": { "name": "email_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
      "After": { "name": "after", "in": "query", "schema": { "type": "string" } },
      "Before": { "name": "before", "in": "query", "schema": { "type": "string" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "schema": { "type": "string", "maxLength": 200 } }
    },
    "requestBodies": { "JsonObject": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } } },
    "schemas": {
      "Error": { "type": "object", "properties": { "error": { "oneOf": [{ "type": "string" }, { "type": "object", "properties": { "message": { "type": "string" } }, "required": ["message"] }] } }, "required": ["error"] },
      "Usage": { "type": "object", "required": ["object", "emails", "contacts", "segments", "broadcasts", "domains", "automation_runs", "rate_limit"], "properties": { "object": { "const": "usage" }, "emails": { "type": "object", "required": ["daily", "monthly"], "properties": { "daily": { "$ref": "#/components/schemas/EmailUsageWindow" }, "monthly": { "$ref": "#/components/schemas/EmailUsageWindow" } } }, "contacts": { "$ref": "#/components/schemas/ResourceUsage" }, "segments": { "$ref": "#/components/schemas/ResourceUsage" }, "broadcasts": { "$ref": "#/components/schemas/ResourceUsage" }, "domains": { "$ref": "#/components/schemas/ResourceUsage" }, "automation_runs": { "type": "object", "required": ["used", "limit", "resets_at"], "properties": { "used": { "type": "integer" }, "limit": { "type": ["integer", "null"] }, "resets_at": { "type": "string", "format": "date-time" } } }, "rate_limit": { "type": "object", "required": ["limit", "duration", "applies_to"], "properties": { "limit": { "type": "integer" }, "duration": { "type": "string" }, "applies_to": { "type": "string" } } } } },
      "ResourceUsage": { "type": "object", "required": ["used", "limit"], "properties": { "used": { "type": "integer" }, "limit": { "type": ["integer", "null"] } } },
